# ============================================================================
# # After 'noteshub' directory is downloaded in your home directory. Run the 
## following three lines of code in your terminal one by one to set up
# # this bash profile.
export NTHUB="$HOME/noteshub"
export GD="$HOME/Google Drive/My Drive"
export NTHUBC1="$GD/noteshubc1"
export CODEBASE="$HOME/codebase"
export DOTFILES="$NTHUB/dotfiles/macos"
ln -fs $DOTFILES/bash_profile_capone $HOME/.bash_profile
# ============================================================================

export UV="$HOME/.local/share/uv" # Where custom uv virtual environments are stored.
export DT="$HOME/Desktop"
export DL="$HOME/Downloads"
export DOC="$HOME/Documents"

# This will add the code command to your system's PATH, allowing you to open Visual Studio Code from the terminal.
export PATH="$PATH:/Applications/Visual Studio Code.app/Contents/Resources/app/bin"
export PATH="$HOME/binaries:$PATH";

# Set `VSCode` as Crontab's editor.
# export VISUAL=code

# ln -fs /opt/homebrew/bin/python3 /opt/homebrew/Cellar/python@3.11/3.11.11/bin/python3.11
# ln -fs /opt/homebrew/bin/pip3 /opt/homebrew/Cellar/python@3.11/3.11.11/bin/pip3.11

# set horizontal-scroll-mode on # to disable word wrap in terminal; not Working !!
# ============================================================================

# It is specific to Git and used by the Git prompt (PS1) script to determine whether to show the dirty state of the working directory.
export GIT_PS1_SHOWDIRTYSTATE=1

# Add `~/bin` to the `$PATH`
export PATH="$HOME/bin:$PATH";

# Order is critical. succeding scripts may depend on the previous ones.
for file in $DOTFILES/{git-completion.bash,git-prompt.sh,git-aliases.bash,secrets.bash,bash_utils.bash,aliases}; do
	[ -r "$file" ] && [ -f "$file" ] && source "$file";
done;
unset file;

# Case-insensitive globbing (used in pathname expansion)
shopt -s nocaseglob;

# Append to the Bash history file, rather than overwriting it
shopt -s histappend;

# Autocorrect typos in path names when using `cd`
shopt -s cdspell;

# Enable some Bash 4 features when possible:
# * `autocd`, e.g. `**/qux` will enter `./foo/bar/baz/qux`
# * Recursive globbing, e.g. `echo **/*.txt`
for option in autocd globstar; do
	shopt -s "$option" 2> /dev/null;
done;

# Add tab completion for many Bash commands
if which brew &> /dev/null && [ -f "$(brew --prefix)/share/bash-completion/bash_completion" ]; then
	source "$(brew --prefix)/share/bash-completion/bash_completion";
elif [ -f /etc/bash_completion ]; then
	source /etc/bash_completion;
fi;

# Enable tab completion for `g` by marking it as an alias for `git`
if type _git &> /dev/null && [ -f /usr/local/etc/bash_completion.d/git-completion.bash ]; then
	complete -o default -o nospace -F _git g;
fi;

# Add tab completion for SSH hostnames based on ~/.ssh/config, ignoring wildcards
[ -e "$HOME/.ssh/config" ] && complete -o "default" -o "nospace" -W "$(grep "^Host" ~/.ssh/config | grep -v "[?*]" | cut -d " " -f2- | tr ' ' '\n')" scp sftp ssh;

# Add tab completion for `defaults read|write NSGlobalDomain`
# You could just use `-g` instead, but I like being explicit
complete -W "NSGlobalDomain" defaults;

# Add `killall` tab completion for common apps
complete -o "nospace" -W "Contacts Calendar Dock Finder Mail Safari iTunes SystemUIServer Terminal Twitter" killall;


# =============================================================================
beautify_prompt
c1_symbolic_links
c1_aliases
source "$NTHUBC1/.utils/bash_utils_c1.sh"
# =============================================================================
# =============================================================================
# Setting PATH for Python 3.9
export PYTHONNOUSERSITE=True # Enable/Disable Python site module ('ENABLE_USER_SITE').
export PYTHONPATH="$NTHUB/utils:${PYTHONPATH}"
# -----------------------------------------------------------------------------
# Add pyenv to PATH
# export PATH="$HOME/.pyenv/bin:$PATH"
export PATH="/opt/homebrew/bin:$PATH" # Add Homebrew to PATH since pyenv is installed via Homebrew
eval "$(pyenv init --path)"
eval "$(pyenv init -)"
##  pyenv-virtualenv is a plugin for pyenv that facilitates the creation and management of Python virtual environments.
eval "$(pyenv virtualenv-init -)"
# ----------------------------------------------------------------------------
export PATH="$HOME/.local/bin:$PATH" # Add local bin to PATH since pipx is installed there
# ============================================================================

if [ -f /usr/local/cof/bin/cofproxy ]
  then source /usr/local/cof/bin/cofproxy > /dev/null 2>&1
fi

eval $(/opt/homebrew/bin/brew shellenv)

