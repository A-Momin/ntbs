export PYTHONPATH="$HOME/mydocs/Software_Development/noteshub/utils:${PYTHONPATH}"
# ============================================================================

# Add mysql into the PATH variable.
export PATH="/usr/local/mysql/bin:$PATH"
export PATH="/usr/local/Cellar/sqlite/3.45.3/bin:$PATH"

