# add java into the path variable
export PATH="/usr/local/opt/openjdk@11/bin:${PATH}"
export JAVA_HOME='/usr/local/opt/openjdk@11'

# add java into the path variable
# export PATH="/usr/local/jdk-11.0.23.jdk/Contents/Home/bin:${PATH}"
